# Konfigurasi Server Lokal
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=false

# Kunci Enkripsi Simetris AES-256-GCM (32 byte / 256-bit dalam Base64)
# Generate kunci baru dengan: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_SECRET_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Lokasi penyimpanan database lokal
DATABASE_PATH=data/vault.db
